# ============================================================================
# Stock Sheet Management System - Environment Variables Example
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit secrets to version control.
# See NFR-DEV-04 for documentation requirements.
# ============================================================================

# ============================================================================
# CLIENT-SIDE VARIABLES (Exposed to browser/app)
# ============================================================================
# These are prefixed with EXPO_PUBLIC_ or REACT_APP_ to be bundled into
# the client build. They are NOT secret and will be visible in the app.

# Supabase project URL
# Find at: https://app.supabase.com/project/[PROJECT_ID]/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key
# Find at: https://app.supabase.com/project/[PROJECT_ID]/settings/api
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Legacy format for compatibility (Supabase JS client also checks these)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SERVER-SIDE VARIABLES (Edge Functions)
# These are NOT exposed to the client. Set in Supabase Dashboard under
# Edge Functions > Environment Variables or in .env.local for local dev.
# ============================================================================

# Supabase project URL (same as client, but used by edge functions)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (same as client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (SECRET - never expose to client)
# Find at: https://app.supabase.com/project/[PROJECT_ID]/settings/api
# Only used server-side in edge functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# Swappable via AI_PROVIDER environment variable (satisfies NFR-SCALE-03)

# AI provider to use: 'claude' or 'ollama'
# Default: 'claude'
# - claude: Uses Anthropic Claude API (production)
# - ollama: Uses self-hosted Ollama (local/private deployments)
AI_PROVIDER=claude

# Anthropic Claude API key
# Get from: https://console.anthropic.com/account/keys
# Required if AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# Ollama configuration
# Used if AI_PROVIDER=ollama
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (default: llava)
# Must be a model with vision capabilities installed in Ollama
OLLAMA_MODEL=llava

# ============================================================================
# POS WEBHOOK CONFIGURATION
# ============================================================================

# Default webhook secret for testing
# In production, each store has its own secret stored in store_integrations table
# Used for HMAC-SHA256 signature validation (satisfies NFR-SEC-06)
POS_WEBHOOK_SECRET=your-webhook-secret-here

# ============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================================================
# These variables are used when running with Supabase local development

# Set to true to use local Supabase instead of cloud
SUPABASE_LOCAL_DEV=true

# Local Supabase API URL
# Default when running `supabase start`
SUPABASE_LOCAL_URL=http://127.0.0.1:54321

# Local Supabase anon key (from supabase/config.toml after `supabase init`)
SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# DEVELOPMENT/DEBUG OPTIONS
# ============================================================================

# Enable verbose logging (set to 'true' for debugging)
DEBUG=false

# Analytics and monitoring (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================================================
# NOTES
# ============================================================================
# 
# SECURITY:
# - Never commit .env.local to version control
# - Keep SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY private
# - Use different keys for development, staging, and production
#
# LOCAL DEVELOPMENT:
# - Run `supabase start` to spin up local Supabase
# - Variables prefixed EXPO_PUBLIC_ and REACT_APP_ are bundled into the app
# - Server-side variables (SUPABASE_*, ANTHROPIC_*, AI_PROVIDER) are not exposed
#
# NAMING CONVENTIONS:
# - EXPO_PUBLIC_* : Exposed to React Native/Expo app
# - REACT_APP_* : Exposed to web (legacy format, also checked by Supabase)
# - SUPABASE_* : Server-side edge function variables
# - Other variables are typically server-side only
#
# PRODUCTION DEPLOYMENT:
# - Set variables in Supabase Dashboard > Project Settings > Edge Functions
# - Secrets should be managed via a secrets management service
# - Use different service role keys per environment
# - Never hardcode any credentials in source code
#
